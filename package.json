{
  "name": "kumvwa",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter api start:dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:console": "pnpm --filter console dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:all": "pnpm --parallel --filter api --filter worker --filter console dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
