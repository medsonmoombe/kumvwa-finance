    "dotenv": "^16.4.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.19.3",
    "typescript": "^5.7.0"
  }
}
