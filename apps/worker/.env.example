# The worker loads apps/api/.env first (DATABASE_URL, EMAIL_*), then any
# worker-local .env below. Only set what differs from the API.

# ── Email (dev: MailHog at http://localhost:8025) ───────
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Kumvwa Finance <no-reply@kumvwa.co.zm>

# ── Worker loop ─────────────────────────────────────────
WORKER_BATCH=20
WORKER_TICK_MS=15000
