generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────

enum TenantStatus {
  pending_verification
  active
  rejected
  suspended
}

enum UserRole {
  platform_admin
  tenant_owner
  tenant_staff
  client
}

enum UserStatus {
  active
  disabled
}

enum ClientStatus {
  active
  blocked
}

enum OtpPurpose {
  registration
  login
  password_reset
  phone_change
  console_2fa
}

enum OtpStatus {
  pending
  verified
  expired
  consumed
}

enum InviteStatus {
  pending
  completed
  expired
  revoked
}

enum LoanStatus {
  active
  overdue
  cleared
  defaulted
}

enum InstallmentStatus {
  pending
  paid
  overdue
}

enum LoanRequestStatus {
  pending
  approved
  rejected
}

enum RepaymentMethod {
  cash
  mobile_money
  bank
  in_app
}

enum NotificationType {
  payment_due
  payment_received
  loan_overdue
  verification
  client_activity
  loan_request
  request_approved
  request_rejected
  system
}

enum SmsStatus {
  queued
  sent
  failed
}

enum CreditCheckSource {
  internal
  transunion
  experian
}

enum FileKind {
  boz_certificate
  kyc_document
  nrc_photo
  tenant_logo
  other
}

enum EducationLevel {
  primary
  junior_secondary
  senior_secondary
  certificate
  diploma
  degree
  postgraduate
  none
}

enum EmploymentStatus {
  formal_employment
  self_employed
  farming
  informal
  other
}

enum IncomeBand {
  b0_1000
  b1001_3000
  b3001_6000
  b6000_plus
}

enum TermsScope {
  platform_business
  platform_client
  tenant
}

// ───────────────────────── models ────────────────────────
// Money rule: all amounts are BigInt MINOR units (ngwee).
// Rate rule: Int basis points (15% = 1500).
// NRC rule:  nrcHash = HMAC-SHA256 (unique, dedupe key),
//            nrcEncrypted = AES-256-GCM (display, audited).

model Tenant {
  id                String       @id @default(cuid())
  name              String
  type              String // sacco | mfi | individual_lender | other
  status            TenantStatus @default(pending_verification)
  settings          Json         @default("{}")
  // BOZ verification journey: stamped when the owner submits their
  // certificate, and `verificationNote` carries the reviewer's reason on
  // rejection (shown back to the owner on the pending screen).
  bozSubmittedAt    DateTime?
  verificationNote  String?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  // Owner's NRC as AES-256-GCM ciphertext, so the reviewer can check it
  // against the certificate. Never emitted except to platform_admin.
  ownerNrcEncrypted String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // ── Business info + white-label branding (logo/color/name) ──
  email             String?
  address           String?
  tpin              String?
  contactPerson     String?
  logoFileId        String?      @unique
  primaryColor      String?
  tagline           String?

  users        User[]
  roles        Role[]
  logoFile     File?              @relation("TenantLogo", fields: [logoFileId], references: [id])
  terms        TenantTerms[]
  files        File[]             @relation("TenantFiles")
  bozFile      File?              @relation("BozCert")
  products     LoanProduct[]
  loans        Loan[]
  clientLinks  ClientLenderLink[]
  invites      Invite[]
  requests     LoanRequest[]
  repayments   Repayment[]
  creditChecks CreditCheck[]
  // ── M5: lending rules (versioned credit ladder) + per-client exceptions ──
  creditPolicy CreditPolicy?
  overrides    ClientLimitOverride[]
}

model User {
  id               String     @id @default(cuid())
  phone            String     @unique // E.164, e.g. +260971234567
  email            String?    @unique // console login identity
  passwordHash     String
  displayName      String
  role             UserRole
  status           UserStatus @default(active)
  tenantId         String?    // set for tenant_owner / tenant_staff
  clientId         String?    @unique // set for client (links identity)
  roleId           String?    // custom staff role (tenant_staff)
  twoFactorEnabled Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant         Tenant?           @relation(fields: [tenantId], references: [id])
  client         Client?           @relation(fields: [clientId], references: [id])
  staffRole      Role?             @relation(fields: [roleId], references: [id])
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  devices        DevicePushToken[]
  trustedDevices TrustedDevice[]

  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users  User[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id                 String            @id @default(cuid())
  // Nullable until the client completes their profile in the app wizard:
  // an invite only mints name + phone + password, KYC lands afterwards.
  nrcHash            String?           @unique // platform-wide dedupe key
  nrcEncrypted       String?
  firstName          String
  lastName           String
  phone              String            @unique
  dob                DateTime?
  address            String?
  // ── Profile stepper (first-login wizard) ──
  // Email is free-text from the stepper (not used for login yet — the OTP
  // question for clients is still open). The rest is the rich profile the
  // lender's KYC review consumes.
  email              String?
  // The NRC is a two-sided card: both faces are captured by the stepper and
  // both ride the same `nrc_photo` file kind (the kind describes the document,
  // not the side). Either side is optional on its own.
  nrcPhotoFileId     String?
  nrcBackPhotoFileId String?
  employmentStatus   EmploymentStatus?
  educationLevel     EducationLevel?
  incomeBand         IncomeBand?
  incomeSource       String?
  kinName            String?
  kinPhone           String?
  profileCompletedAt DateTime?
  status             ClientStatus      @default(active)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user         User?
  lenderLinks  ClientLenderLink[]
  loans        Loan[]
  requests     LoanRequest[]
  creditChecks CreditCheck[]
  invites      Invite[]
  overrides    ClientLimitOverride[]
}

model ClientLenderLink {
  id        String   @id @default(cuid())
  clientId  String
  tenantId  String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([clientId, tenantId])
  @@index([tenantId])
}

model Invite {
  id          String       @id @default(cuid())
  tokenHash   String       @unique // never store raw invite token
  tenantId    String
  clientId    String? // linked when dedupe-match occurs
  clientName  String
  phone       String
  status      InviteStatus @default(pending)
  createdBy   String // userId of lender
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([tenantId, status])
}

model LoanProduct {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  // ── C2: human-facing identifiers. `code` is the lender's own product code
  // (e.g. PL-001) shown on screens and reports; `description` is an internal
  // note clients never see.
  code              String?
  description       String?
  rateBps           Int
  minAmount         BigInt // ngwee
  maxAmount         BigInt
  minTerm           Int
  maxTerm           Int
  active            Boolean  @default(true)
  // ── M4 money-maturity knobs ──
  frequency         String   @default("monthly") // monthly | weekly | fortnightly
  originationFeeBps Int      @default(0)
  feeTreatment      String   @default("add") // add | deduct
  penaltyBpsPerDay  Int      @default(0) // 0 = penalties off
  penaltyCapBps     Int      @default(2000)
  // ── M5: repayment structure — bullet (one maturity) is the market default ──
  repaymentStructure String  @default("bullet") // bullet | installments
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  loans  Loan[]

  @@index([tenantId])
}

model Loan {
  id                String     @id @default(cuid())
  tenantId          String
  clientId          String
  productId         String?
  principal         BigInt
  rateBps           Int
  termCount         Int
  totalDue          BigInt
  paidAmount        BigInt     @default(0)
  // ── M4 money-maturity fields ──
  frequency         String     @default("monthly")
  feeMinor          BigInt     @default(0)
  disbursementMinor BigInt     @default(0)
  rolloverCount     Int        @default(0)
  // ── M5: friendly human reference (LN-2026-00001) + structure snapshot ──
  loanRef           String     @unique
  repaymentStructure String    @default("installments") // bullet | installments
  status            LoanStatus @default(active)
  disbursedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  product      LoanProduct?  @relation(fields: [productId], references: [id])
  installments Installment[]
  repayments   Repayment[]
  request      LoanRequest?  @relation("LoanFromRequest")

  @@index([tenantId, status])
  @@index([clientId])
}

model Installment {
  id           String            @id @default(cuid())
  loanId       String
  seq          Int
  dueDate      DateTime          @db.Date
  amount       BigInt
  paidAmount   BigInt            @default(0)
  // ── M4: accrued late penalty riding with this installment ──
  penaltyMinor BigInt            @default(0)
  status       InstallmentStatus @default(pending)
  paidAt       DateTime?

  loan Loan @relation(fields: [loanId], references: [id])

  @@unique([loanId, seq])
  @@index([status, dueDate]) // overdue-scan job hot path
}

model Repayment {
  id             String          @id @default(cuid())
  loanId         String
  tenantId       String
  amount         BigInt
  method         RepaymentMethod
  reference      String?
  idempotencyKey String          @unique
  recordedBy     String? // userId
  createdAt      DateTime        @default(now())

  loan   Loan   @relation(fields: [loanId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([loanId])
  @@index([tenantId, createdAt])
}

model LoanRequest {
  id         String            @id @default(cuid())
  tenantId   String
  clientId   String
  amount     BigInt
  termCount  Int
  purpose    String
  status     LoanRequestStatus @default(pending)
  feedback   String?
  reviewedBy String?
  reviewedAt DateTime?
  loanId     String?           @unique // set when approved
  createdAt  DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  loan   Loan?  @relation("LoanFromRequest", fields: [loanId], references: [id])

  @@index([tenantId, status])
  @@index([clientId])
}

model CreditCheck {
  id        String            @id @default(cuid())
  clientId  String
  tenantId  String // who requested the check
  source    CreditCheckSource
  score     Int?
  band      String? // low | medium | high
  payload   Json?
  checkedAt DateTime          @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([clientId, checkedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // deep-link payload, e.g. { "loanId": "..." }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // android | ios
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SmsOutbox {
  id          String    @id @default(cuid())
  phone       String
  body        String
  purpose     String // otp | reminder | notification
  status      SmsStatus @default(queued)
  provider    String?
  providerRef String?
  error       String?
  attempts    Int       @default(0)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  userId     String?    // set for console_2fa (keyed on user, not phone)
  purpose    OtpPurpose
  codeHash   String     // OTP is hashed like a password — never plaintext
  status     OtpStatus  @default(pending)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, status])
  @@index([userId, purpose, status])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  sessionId   String // rotation family — all tokens from one login share it
  deviceId    String?
  ip          String?
  rotatedFrom String?   @unique // rotation family chain → reuse detection
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // loose ref (no FK) — log survives user deletion
  action    String // auth.login | loan.approve | pii.read | ...
  entity    String?
  entityId  String?
  tenantId  String?
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
}

model File {
  id         String    @id @default(cuid())
  tenantId   String?
  kind       FileKind
  storageKey String    @unique
  mime       String
  size       Int
  checksum   String
  scannedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant       Tenant? @relation("TenantFiles", fields: [tenantId], references: [id])
  bozCertOf    Tenant? @relation("BozCert", fields: [bozCertOfId], references: [id])
  bozCertOfId  String? @unique
  logoOfTenant Tenant? @relation("TenantLogo")
}

// ───────────────── terms (two-layer, versioned) ─────────────────
// Platform terms are Kumvwa-wide; tenant terms belong to one lender. Both
// are append-only version streams — acceptances reference a specific version.

model PlatformTerms {
  id          String   @id @default(cuid())
  version     Int      @unique
  body        String   @db.Text
  publishedAt DateTime @default(now())
}

model TenantTerms {
  id          String   @id @default(cuid())
  tenantId    String
  version     Int
  body        String   @db.Text
  publishedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, version])
  @@index([tenantId])
}

model TermsAcceptance {
  id              String     @id @default(cuid())
  actorId         String
  clientId        String?
  scope           TermsScope
  tenantId        String?
  platformVersion Int?
  tenantVersion   Int?
  ip              String?
  createdAt       DateTime   @default(now())

  @@index([actorId, scope])
  @@index([clientId, scope])
}

// ───────────────── email outbox ─────────────────
// Same shape as SmsOutbox so the worker consumer pattern is identical.

model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String    @db.Text
  purpose   String // invite | notification | otp
  status    SmsStatus @default(queued)
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

// ── M5: per-tenant lending rules (the credit ladder) ──
model CreditPolicy {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  version     Int      @default(1)
  policy      Json
  publishedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ── M5: audited per-client limit exception (console grant/revoke) ──
model ClientLimitOverride {
  id          String   @id @default(cuid())
  clientId    String
  tenantId    String
  limitKwacha Int
  reason      String
  grantedBy   String // userId of the owner/staff who granted it
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([clientId, tenantId])
}

// ── C4: platform-wide feature flags & killswitches ──
model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
