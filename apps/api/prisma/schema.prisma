generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────

enum TenantStatus {
  pending_verification
  active
  rejected
  suspended
}

enum UserRole {
  platform_admin
  tenant_owner
  tenant_staff
  client
}

enum UserStatus {
  active
  disabled
}

enum ClientStatus {
  active
  blocked
}

enum OtpPurpose {
  registration
  login
  password_reset
  phone_change
  console_2fa
}

enum OtpStatus {
  pending
  verified
  expired
  consumed
}

enum InviteStatus {
  pending
  completed
  expired
  revoked
}

enum LoanStatus {
  active
  overdue
  cleared
  defaulted
}

enum InstallmentStatus {
  pending
  paid
  overdue
}

enum LoanRequestStatus {
  pending
  approved
  rejected
}

enum RepaymentMethod {
  cash
  mobile_money
  bank
  in_app
}

enum NotificationType {
  payment_due
  payment_received
  loan_overdue
  verification
  client_activity
  loan_request
  request_approved
  request_rejected
  system
}

enum SmsStatus {
  queued
  sent
  failed
}

enum CreditCheckSource {
  internal
  transunion
  experian
}

enum FileKind {
  boz_certificate
  kyc_document
  nrc_photo
  tenant_logo
  profile_image
  other
}

enum EducationLevel {
  primary
  junior_secondary
  senior_secondary
  certificate
  diploma
  degree
  postgraduate
  none
}

enum EmploymentStatus {
  formal_employment
  self_employed
  farming
  informal
  other
}

enum IncomeBand {
  b0_1000
  b1001_3000
  b3001_6000
  b6000_plus
}

enum TermsScope {
  platform_business
  platform_client
  tenant
}

// ── payments engine enums ──
enum PaymentPurpose {
  loan_repayment
  loan_disbursement
  client_slots
  invoice
  other
}

enum PaymentMethod {
  mobile_money
  card
}

enum PaymentProvider {
  mtn_momo
  airtel_money
  zamtel_kwacha
  card_psp
  sandbox
}

enum PaymentStatus {
  requires_action
  processing
  succeeded
  failed
  cancelled
  expired
  refunded
  partially_refunded
}

/// Double-entry ledger account the transaction line posts to.
enum LedgerAccount {
  external_provider
  loan_receivable
  tenant_payable
  platform_slot_revenue
  platform_fee
}

// ───────────────────────── models ────────────────────────
// Money rule: all amounts are BigInt MINOR units (ngwee).
// Rate rule: Int basis points (15% = 1500).
// NRC rule:  nrcHash = HMAC-SHA256 (unique, dedupe key),
//            nrcEncrypted = AES-256-GCM (display, audited).

model Tenant {
  id                String       @id @default(cuid())
  name              String
  type              String // sacco | mfi | individual_lender | other
  status            TenantStatus @default(pending_verification)
  settings          Json         @default("{}")
  // BOZ verification journey: stamped when the owner submits their
  // certificate, and `verificationNote` carries the reviewer's reason on
  // rejection (shown back to the owner on the pending screen).
  bozSubmittedAt    DateTime?
  verificationNote  String?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  // Owner's NRC as AES-256-GCM ciphertext, so the reviewer can check it
  // against the certificate. Never emitted except to platform_admin.
  ownerNrcEncrypted String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // ── Business info + white-label branding (logo/color/name) ──
  email             String?
  address           String?
  tpin              String?
  contactPerson     String?
  businessDescription String?
  logoFileId        String?      @unique
  primaryColor      String?
  tagline           String?

  users        User[]
  roles        Role[]
  logoFile     File?              @relation("TenantLogo", fields: [logoFileId], references: [id])
  terms        TenantTerms[]
  files        File[]             @relation("TenantFiles")
  bozFile      File?              @relation("BozCert")
  products     LoanProduct[]
  loans        Loan[]
  clientLinks  ClientLenderLink[]
  invites      Invite[]
  requests     LoanRequest[]
  repayments   Repayment[]
  creditChecks CreditCheck[]
  // ── M5: lending rules (versioned credit ladder) + per-client exceptions ──
  creditPolicy CreditPolicy?
  overrides    ClientLimitOverride[]
  reviewEvents TenantReviewEvent[]
  subscription TenantSubscription?
  slotPurchases ClientSlotPurchase[]
}

/// Immutable audit trail for a lender's registration review lifecycle.
model TenantReviewEvent {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String   // registered | application_updated | resubmitted | approved | rejected | evidence_submitted
  note      String?
  changes   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
}

model User {
  id               String     @id @default(cuid())
  phone            String     @unique // E.164, e.g. +260971234567
  email            String?    @unique // console login identity
  passwordHash     String
  displayName      String
  role             UserRole
  status           UserStatus @default(active)
  tenantId         String?    // set for tenant_owner / tenant_staff
  clientId         String?    @unique // set for client (links identity)
  roleId           String?    // custom staff role (tenant_staff)
  profileFileId    String?    @unique
  twoFactorEnabled Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant         Tenant?           @relation(fields: [tenantId], references: [id])
  client         Client?           @relation(fields: [clientId], references: [id])
  staffRole      Role?             @relation(fields: [roleId], references: [id])
  profileFile    File?             @relation("UserProfileImage", fields: [profileFileId], references: [id])
  uploadedFiles  File[]            @relation("UploadedFiles")
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  mobileAccessCodes MobileAccessCode[]
  devices        DevicePushToken[]
  trustedDevices TrustedDevice[]
  reviewEvents   TenantReviewEvent[]

  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users  User[]
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id                 String            @id @default(cuid())
  // Nullable until the client completes their profile in the app wizard:
  // an invite only mints name + phone + password, KYC lands afterwards.
  nrcHash            String?           @unique // platform-wide dedupe key
  nrcEncrypted       String?
  firstName          String
  lastName           String
  phone              String            @unique
  dob                DateTime?
  address            String?
  // ── Profile stepper (first-login wizard) ──
  // Email is free-text from the stepper (not used for login yet — the OTP
  // question for clients is still open). The rest is the rich profile the
  // lender's KYC review consumes.
  email              String?
  // The NRC is a two-sided card: both faces are captured by the stepper and
  // both ride the same `nrc_photo` file kind (the kind describes the document,
  // not the side). Either side is optional on its own.
  nrcPhotoFileId     String?
  nrcBackPhotoFileId String?
  employmentStatus   EmploymentStatus?
  educationLevel     EducationLevel?
  incomeBand         IncomeBand?
  incomeSource       String?
  kinName            String?
  kinPhone           String?
  kin2Name           String?
  kin2Phone          String?
  profileCompletedAt DateTime?
  status             ClientStatus      @default(active)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user         User?
  lenderLinks  ClientLenderLink[]
  loans        Loan[]
  requests     LoanRequest[]
  creditChecks CreditCheck[]
  invites      Invite[]
  overrides    ClientLimitOverride[]
}

model ClientLenderLink {
  id        String   @id @default(cuid())
  clientId  String
  tenantId  String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([clientId, tenantId])
  @@index([tenantId])
}

model Invite {
  id          String       @id @default(cuid())
  tokenHash   String       @unique // never store raw invite token
  tenantId    String
  clientId    String? // linked when dedupe-match occurs
  clientName  String
  phone       String
  status      InviteStatus @default(pending)
  createdBy   String // userId of lender
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([tenantId, status])
}

model LoanProduct {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  // ── C2: human-facing identifiers. `code` is the lender's own product code
  // (e.g. PL-001) shown on screens and reports; `description` is an internal
  // note clients never see.
  code              String?
  description       String?
  rateBps           Int
  minAmount         BigInt // ngwee
  maxAmount         BigInt
  minTerm           Int
  maxTerm           Int
  active            Boolean  @default(true)
  // ── M4 money-maturity knobs ──
  frequency         String   @default("monthly") // monthly | weekly | fortnightly
  originationFeeBps Int      @default(0)
  feeTreatment      String   @default("add") // add | deduct
  penaltyBpsPerDay  Int      @default(0) // 0 = penalties off
  penaltyCapBps     Int      @default(2000)
  // ── M5: repayment structure — bullet (one maturity) is the market default ──
  repaymentStructure String  @default("bullet") // bullet | installments
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  loans  Loan[]

  @@index([tenantId])
}

model Loan {
  id                String     @id @default(cuid())
  tenantId          String
  clientId          String
  productId         String?
  principal         BigInt
  rateBps           Int
  termCount         Int
  totalDue          BigInt
  paidAmount        BigInt     @default(0)
  // ── M4 money-maturity fields ──
  frequency         String     @default("monthly")
  feeMinor          BigInt     @default(0)
  disbursementMinor BigInt     @default(0)
  rolloverCount     Int        @default(0)
  // ── M5: friendly human reference (LN-2026-00001) + structure snapshot ──
  loanRef           String     @unique
  repaymentStructure String    @default("installments") // bullet | installments
  // ── Immutable terms: the conditions this loan was ISSUED at ──
  // Frozen at disbursement as canonical JSON + a sha256 of that JSON. Nothing
  // afterwards may rewrite these; the hash makes any attempt detectable, which
  // is what settles "I never agreed to that rate" disputes. `termsSnapshot` is
  // deliberately separate from the live columns (a rollover moves due dates and
  // grows totalDue — the ORIGINAL agreement must not move with them).
  termsSnapshot     Json?
  termsHash         String?
  status            LoanStatus @default(active)
  disbursedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  product      LoanProduct?  @relation(fields: [productId], references: [id])
  installments Installment[]
  repayments   Repayment[]
  request      LoanRequest?  @relation("LoanFromRequest")

  @@index([tenantId, status])
  @@index([clientId])
}

model Installment {
  id           String            @id @default(cuid())
  loanId       String
  seq          Int
  dueDate      DateTime          @db.Date
  amount       BigInt
  paidAmount   BigInt            @default(0)
  // ── M4: accrued late penalty riding with this installment ──
  penaltyMinor BigInt            @default(0)
  // ── Interest accounting: the interest baked into THIS installment ──
  // Flat interest spread across the original plan (see core `distributeInterest`).
  // A rollover-appended extension row is pure interest; a bullet bump grows it.
  interestMinor BigInt           @default(0)
status       InstallmentStatus @default(pending)
    paidAt       DateTime?
    // Last Zambian civil day a late penalty was accrued for this installment.
    // Persistent on purpose: an in-memory day gate re-accrues a day whenever the
    // worker restarts, and two overlapping ticks race on the read-modify-write.
    lastPenaltyDate DateTime?      @db.Date

    loan Loan @relation(fields: [loanId], references: [id])

    @@unique([loanId, seq])
    @@index([status, dueDate]) // overdue-scan job hot path
    @@index([lastPenaltyDate]) // penalty-sweep hot path
  }

model Repayment {
  id             String          @id @default(cuid())
  loanId         String
  tenantId       String
  amount         BigInt
  // ── How much of this cash was INTEREST (the rest is principal/penalty) ──
  // Derived exactly at record time from each installment's own `interestMinor`
  // pro-rata to the amount credited, so "interest generated" is a ledger sum,
  // not a fuzzy estimate. A `rollover_interest` row is interest in full.
  interestMinor  BigInt          @default(0)
  kind           String          @default("repayment") // repayment | rollover_interest
  method         RepaymentMethod
  reference      String?
  idempotencyKey String          @unique
  // ── payments engine: the intent that moved the money (loose ref, no FK) ──
  paymentIntentId String?        @unique
  recordedBy     String? // userId
  createdAt      DateTime        @default(now())

  loan   Loan   @relation(fields: [loanId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([loanId])
  @@index([tenantId, createdAt])
  // Reporting reads sum interest per tenant (migration
  // 20261002120000_loan_terms_and_interest). Declared here so the schema and
  // the applied migration agree — otherwise the next `migrate dev` drops it.
  @@index([tenantId, interestMinor])
}

model LoanRequest {
  id         String            @id @default(cuid())
  tenantId   String
  clientId   String
  amount     BigInt
  termCount  Int
  purpose    String
  status     LoanRequestStatus @default(pending)
  feedback   String?
  reviewedBy String?
  reviewedAt DateTime?
  loanId     String?           @unique // set when approved
  createdAt  DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  loan   Loan?  @relation("LoanFromRequest", fields: [loanId], references: [id])

  @@index([tenantId, status])
  @@index([clientId])
}

model CreditCheck {
  id        String            @id @default(cuid())
  clientId  String
  tenantId  String // who requested the check
  source    CreditCheckSource
  score     Int?
  band      String? // low | medium | high
  payload   Json?
  checkedAt DateTime          @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([clientId, checkedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // deep-link payload, e.g. { "loanId": "..." }
  readAt    DateTime?
  createdAt DateTime         @default(now())
  /// Set by the worker once this notification has been fanned out to the user's
  /// devices. Null = still owed a push. In-app delivery never depends on it.
  pushedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([pushedAt, createdAt])
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // android | ios
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  // The push fan-out looks tokens up by user on every notification.
  @@index([userId])
}

model SmsOutbox {
  id          String    @id @default(cuid())
  phone       String
  body        String
  purpose     String // otp | reminder | notification
  status      SmsStatus @default(queued)
  provider    String?
  providerRef String?
  error       String?
  attempts    Int       @default(0)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  userId     String?    // set for console_2fa (keyed on user, not phone)
  purpose    OtpPurpose
  codeHash   String     // OTP is hashed like a password — never plaintext
  status     OtpStatus  @default(pending)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, status])
  @@index([userId, purpose, status])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  sessionId   String // rotation family — all tokens from one login share it
  deviceId    String?
  ip          String?
  rotatedFrom String?   @unique // rotation family chain → reuse detection
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String? // loose ref (no FK) — log survives user deletion
  action      String // auth.login | loan.approve | pii.read | ...
  description String? // brief human-readable summary of what happened
  entity      String?
  entityId    String?
  tenantId    String?
  diff        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
}

model File {
  id         String    @id @default(cuid())
  tenantId   String?
  uploadedById String?
  kind       FileKind
  storageKey String    @unique
  mime       String
  size       Int
  checksum   String
  scannedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant       Tenant? @relation("TenantFiles", fields: [tenantId], references: [id])
  uploadedBy   User?   @relation("UploadedFiles", fields: [uploadedById], references: [id])
  profileOfUser User?  @relation("UserProfileImage")
  bozCertOf    Tenant? @relation("BozCert", fields: [bozCertOfId], references: [id])
  bozCertOfId  String? @unique
  logoOfTenant Tenant? @relation("TenantLogo")

  // Declared to match migration 20260930120000_user_profile_images, which
  // already created this index in the database.
  @@index([uploadedById])
}

// ───────────────── terms (two-layer, versioned) ─────────────────
// Platform terms are Kumvwa-wide; tenant terms belong to one lender. Both
// are append-only version streams — acceptances reference a specific version.

enum LegalDocumentKind {
  terms
  privacy
}

model PlatformTerms {
  id          String            @id @default(cuid())
  kind        LegalDocumentKind @default(terms)
  version     Int
  body        String            @db.Text
  publishedAt DateTime          @default(now())

  // Versioning is per-document: terms v3 and privacy v1 are unrelated.
  @@unique([kind, version])
  @@index([kind, version])
}

model TenantTerms {
  id          String   @id @default(cuid())
  tenantId    String
  version     Int
  body        String   @db.Text
  publishedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, version])
  @@index([tenantId])
}

model TermsAcceptance {
  id              String     @id @default(cuid())
  actorId         String
  clientId        String?
  scope           TermsScope
  tenantId        String?
  platformVersion Int?
  tenantVersion   Int?
  ip              String?
  createdAt       DateTime   @default(now())

  @@index([actorId, scope])
  @@index([clientId, scope])
}

// ───────────────── email outbox ─────────────────
// Same shape as SmsOutbox so the worker consumer pattern is identical.

model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  body      String    @db.Text
  purpose   String // invite | notification | otp
  status    SmsStatus @default(queued)
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

model MobileAccessCode {
  id          String   @id @default(cuid())
  codeHash    String   @unique
  userId      String
  tenantId    String
  generatedBy String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tenantId, createdAt])
}

// ── M5: per-tenant lending rules (the credit ladder) ──
model CreditPolicy {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  version     Int      @default(1)
  policy      Json
  publishedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ── M5: audited per-client limit exception (console grant/revoke) ──
model ClientLimitOverride {
  id          String   @id @default(cuid())
  clientId    String
  tenantId    String
  limitKwacha Int
  reason      String
  grantedBy   String // userId of the owner/staff who granted it
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([clientId, tenantId])
}

// ── C4: platform-wide feature flags & killswitches ──
model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ───────────────── payments engine ─────────────────
// Every money movement on the platform flows through a PaymentIntent: loan
// repayments, loan disbursements, client-slot purchases. The intent is the
// client-facing idempotency + status object; PaymentTransaction is the
// append-only ledger; Payout is the disbursement leg. The domain effect is
// applied by PaymentsService only once the intent is settled (succeeded).
//
// tenantId/clientId/loanId are loose refs (no FK), like AuditLog, so the
// ledger survives independently of the rows it describes.

model PaymentIntent {
  id             String          @id @default(cuid())
  reference      String          @unique // PAY-2026-00001
  purpose        PaymentPurpose
  tenantId       String?
  payerUserId    String?
  clientId       String?
  loanId         String?
  amountMinor    BigInt
  currency       String          @default("ZMW")
  method         PaymentMethod
  provider       PaymentProvider
  payerPhone     String? // MoMo push target ("their current number")
  status         PaymentStatus   @default(requires_action)
  idempotencyKey String          @unique
  providerRef    String? // PSP charge id
  failureReason  String?
  metadata       Json            @default("{}")
  expiresAt      DateTime?
  /// Times the reconciler has polled the provider for a stuck `processing`
  /// charge. Caps retries so an unanswerable charge is left for a human
  /// instead of being polled forever.
  reconcileAttempts Int          @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions PaymentTransaction[]
  payout       Payout?

  @@index([tenantId, status])
  @@index([clientId])
  @@index([status, createdAt])
}

model PaymentTransaction {
  id          String        @id @default(cuid())
  intentId    String
  entryType   String // charge | disbursement | refund | fee | adjustment
  account     LedgerAccount
  direction   String // debit | credit
  amountMinor BigInt
  providerRef String?
  rawPayload  Json?
  createdAt   DateTime      @default(now())

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
}

model PaymentWebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventId     String // provider's event id → replay protection
  signatureOk Boolean         @default(false)
  payload     Json
  processedAt DateTime?
  status      String          @default("received") // received | processed | failed | ignored
  error       String?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([status, createdAt])
}

model Payout {
  id          String          @id @default(cuid())
  intentId    String?         @unique
  tenantId    String
  clientId    String
  loanId      String
  amountMinor BigInt
  provider    PaymentProvider
  phone       String
  status      PaymentStatus   @default(requires_action)
  providerRef String?
  /// Set by the worker's payout watchdog when a disbursement goes unresolved
  /// past the settlement window. NOT a status change — a human reconciles it.
  failureReason String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  intent PaymentIntent? @relation(fields: [intentId], references: [id])

  @@index([tenantId, status])
  @@index([loanId])
}

// ───────────────── billing: client slots ─────────────────
// Free floor (default 3 clients) per lender; each additional client is a paid
// monthly slot (default K100). Slots lapse after one month. Platform admins
// override the plan, price and floor per lender (promotions) and every change
// is recorded as a BillingEvent.

model BillingPlan {
  id                       String   @id @default(cuid())
  key                      String   @unique
  name                     String
  includedClients          Int      @default(3)
  pricePerExtraClientMinor BigInt
  interval                 String   @default("monthly")
  active                   Boolean  @default(true)
  isDefault                Boolean  @default(false)
  features                 Json     @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                      String    @id @default(cuid())
  tenantId                String    @unique
  planId                  String
  status                  String    @default("active") // active | past_due | grace | suspended | cancelled
  includedClientsOverride Int?
  priceOverrideMinor      BigInt?
  extraSlots              Int       @default(0)
  slotsExpireAt           DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  promoNote               String?
  updatedBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  plan   BillingPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
}

model ClientSlotPurchase {
  id              String   @id @default(cuid())
  tenantId        String
  purchasedCount  Int
  unitPriceMinor  BigInt
  amountMinor     BigInt
  periodStart     DateTime
  periodEnd       DateTime // exactly one month after activation
  paymentIntentId String?  @unique
  status          String   @default("pending") // pending | active | expired | refunded
  createdBy       String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model BillingEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  type      String // plan_change | override | promotion | suspend | grant_grace | slots_expired
  fromValue Json?
  toValue   Json?
  actorId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
