# ── Runtime ─────────────────────────────────────────────
NODE_ENV=dev
PORT=8080
# Comma-separated allowlist. Empty = allow all (DEV ONLY).
# 3000 = mobile/web dev server, 5173 = management console (Vite).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database / Cache ────────────────────────────────────
DATABASE_URL=postgresql://kumvwa:kumvwa_dev@localhost:55432/kumvwa?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth (prod: openssl rand -base64 48) ────────────────
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32-chars!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32-chars!
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Crypto (prod: openssl rand -base64 32) ──────────────
NRC_HMAC_KEY=dev-only-nrc-hmac-key-change-me-32-chars!!
FIELD_ENCRYPTION_KEY=dev-only-field-enc-key-change-me-32-chars!

# ── OTP — hardcoded in dev; random + SMS in prod ────────
OTP_DEV_MODE=true
OTP_DEV_CODE=123456
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# ── SMS provider (none = log-only outbox) ───────────────
SMS_PROVIDER=none
SMS_SENDER_ID=KUMVWA
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── Email (dev: MailHog at :8025) ───────────────────────
# Empty SMTP_HOST = log-only dev mode. Set SMTP_HOST=localhost
# and restart the worker to watch mail land in MailHog.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kumvwa Finance <no-reply@kumvwa.co.zm>
APP_BASE_URL=http://localhost:5173

# ── Loan requests / push ────────────────────────────────
REQUEST_MIN_KWACHA=100
REQUEST_MAX_TERM=12
CREDIT_LIMIT_NO_HISTORY_KWACHA=1000
FCM_SERVER_KEY=

# ── Object storage (MinIO in dev) ───────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kumvwa-dev
S3_SECRET_KEY=kumvwa-dev-secret
S3_BUCKET=kumvwa-documents

# ── External integrations ───────────────────────────────
FCM_PROJECT_ID=
SENTRY_DSN=
