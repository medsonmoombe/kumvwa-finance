# ── Runtime ─────────────────────────────────────────────
NODE_ENV=dev
PORT=8080
# Comma-separated allowlist. Empty = allow all (DEV ONLY).
# 3000 = mobile/web dev server, 5173 = management console (Vite).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database / Cache ────────────────────────────────────
DATABASE_URL=postgresql://kumvwa:kumvwa_dev@localhost:55432/kumvwa?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth (prod: openssl rand -base64 48) ────────────────
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32-chars!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32-chars!
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Crypto (prod: openssl rand -base64 32) ──────────────
NRC_HMAC_KEY=dev-only-nrc-hmac-key-change-me-32-chars!!
FIELD_ENCRYPTION_KEY=dev-only-field-enc-key-change-me-32-chars!

# ── OTP — hardcoded in dev; random + SMS in prod ────────
OTP_DEV_MODE=true
OTP_DEV_CODE=123456
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
CONSOLE_2FA_TTL_MIN=5
TRUSTED_DEVICE_DAYS=30
# 'disabled' skips console 2FA entirely: sign-in completes on email + password
# with no OTP screen (mobile OTP is unaffected). Set to 'enabled' to restore.
CONSOLE_OTP_FLOW=disabled

# ── SMS provider (none = log-only outbox) ───────────────
SMS_PROVIDER=none
SMS_SENDER_ID=KUMVWA
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── Email (dev: MailHog at :8025) ───────────────────────
# Empty EMAIL_HOST = log-only dev mode. Set EMAIL_HOST=localhost
# and restart the worker to watch mail land in MailHog.
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Kumvwa Finance <no-reply@kumvwa.co.zm>
APP_BASE_URL=http://localhost:5173

# ── Loan requests / push ────────────────────────────────
REQUEST_MIN_KWACHA=100
REQUEST_MAX_TERM=12
CREDIT_LIMIT_NO_HISTORY_KWACHA=1000
# Max consecutive "pay interest & extend" rollovers per loan (M4). Lower it
# without a deploy if a product line should be capped tighter.
ROLLOVER_MAX=2
FCM_SERVER_KEY=

# ── Storage ─────────────────────────────────────────────
# 'local' = the project ./docs folder, streamed through /files/local-storage/*.
# 's3'    = MinIO (dev) / AWS S3 / Cloudflare R2. REQUIRED in prod: hosts like
#           Render have no persistent disk, so 'local' loses every upload.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=docs

# Every presigned upload/download URL is minted from this, so it must be an
# address the CLIENT can reach — not the API's own loopback. Point it at:
#   Android emulator -> http://10.0.2.2:8080/api/v1
#   iOS sim / web    -> http://localhost:8080/api/v1
#   device on LAN    -> http://<your-lan-ip>:8080/api/v1
#   prod             -> https://<api-host>/api/v1
# Wrong value = uploads and lender logos 404 for the mobile app and console.
API_PUBLIC_URL=http://localhost:8080/api/v1

# ── Object storage (when STORAGE_DRIVER=s3) ───────────────────
# Backblaze B2: https://s3.<region>.backblazeb2.com — note the region in the
# hostname. Keys are an APPLICATION key ID + APPLICATION key; the master key
# is rejected by the S3 API. The bucket also needs a CORS rule allowing
# "S3 Put Object" (and "S3 Get Object") for the console's origin, or browsers
# fail every upload at the preflight B2 denies by default.
S3_ENDPOINT=http://localhost:9000
# Region is signed into every request. Leave empty to read it off a Backblaze
# endpoint (us-east-005 from s3.us-east-005.backblazeb2.com); set it explicitly
# for any other provider. B2 rejects a request signed for the wrong region.
S3_REGION=
S3_ACCESS_KEY=kumvwa-dev
S3_SECRET_KEY=kumvwa-dev-secret
S3_BUCKET=kumvwa-documents

# ── Payments ────────────────────────────────────────────
# 'sandbox' routes EVERY rail (MTN/Airtel/Zamtel/card) to the deterministic
# in-process driver, so the full flow is testable with no credentials and no
# money moves. Prod refuses to boot on 'sandbox' — it would report charges as
# succeeded without collecting anything.
PAYMENTS_DRIVER=sandbox
# Deliberate opt-out of the sandbox-in-prod boot guard, for a launch/testing
# deploy that has no payment-provider contract yet. Every charge auto-approves
# WITHOUT moving money — never take real payments this way. A real
# PAYMENTS_WEBHOOK_SECRET is still required even when this is true.
PAYMENTS_ALLOW_SANDBOX_IN_PROD=false
# HMAC secret for inbound payment webhooks. Prod rejects the shipped dev value.
# Generate with: openssl rand -base64 48
PAYMENTS_WEBHOOK_SECRET=dev-only-payments-webhook-secret
# Minutes an open intent may sit before the sweeper may expire it.
PAYMENTS_INTENT_TTL_MIN=15

# Per-rail credentials. Leave blank to leave a rail OFF: the registry then
# refuses it with a 503 naming the variable, instead of silently charging
# nothing. Only consulted when PAYMENTS_DRIVER=live.
# MTN MoMo — Collections API subscription key (096/056/076 prefixes).
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_WEBHOOK_SECRET=
# Airtel Money — openapi.airtel.africa app credentials (097/077/057 prefixes).
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_WEBHOOK_SECRET=
# Zamtel Kwacha — api-key header auth (095 prefix).
ZAMTEL_KWACHA_BASE_URL=https://api.zamtel.co.zm
ZAMTEL_KWACHA_API_KEY=
ZAMTEL_KWACHA_WEBHOOK_SECRET=
# Card PSP. No PAN is ever sent to Kumvwa: the API returns a client secret for
# the PSP's own SDK to collect card details, and only the token is stored.
CARD_PSP_BASE_URL=
CARD_PSP_API_KEY=
CARD_PSP_WEBHOOK_SECRET=

# ── External integrations ───────────────────────────────
# Firebase Cloud Messaging (HTTP v1). The legacy server-key send API was
# retired by Google, so a service account is the only way to deliver a push.
# Paste the service-account JSON, or a path to the file. Left blank, the worker
# logs each push to its console instead of sending — in-app notifications and
# every other feature work either way.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
SENTRY_DSN=
